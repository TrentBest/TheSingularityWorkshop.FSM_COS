<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.FSM_COS</PackageId>
    <Version>0.1.0-alpha.6</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Platform-neutral computation composition kernel for resolving, loading, arbitrating, and assembling MicroBundle-based computation.</Description>
    <PackageTags>FSM;runtime;composition;microbundle;experience</PackageTags>
    <PackageReadmeFile>NuGet.README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheSingularityWorkshop.FSM_API" Version="1.0.13" />
    <PackageReference Include="TheSingularityWorkshop.FSM_UserIO" Version="0.1.0-alpha.1" />
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../NuGet.README.md" Pack="true" PackagePath="" />
    <None Include="../../DOCUMENTATION_STANDARD.md" Pack="true" PackagePath="" />
    <None Include="../../DOCUMENTATION_INDEX.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="../../docs/*.md"
          Exclude="../../docs/BRANCH_RECONCILIATION.md;../../docs/CONTINUATION_BRIEF_ALPHA6_FORGE_ANYAPP_WEBPAGE.md;../../docs/DEPENDENCY_ALIGNMENT_CHECKLIST.md;../../docs/PAUSE_POINT.md"
          Pack="true"
          PackagePath="docs/" />
    <None Include="../../docs/releases/*.md" Pack="true" PackagePath="docs/releases/" />
    <None Include="../../docs/assets/**/*" Pack="true" PackagePath="docs/assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
