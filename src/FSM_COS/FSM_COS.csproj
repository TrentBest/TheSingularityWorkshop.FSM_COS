<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.FSM_COS</PackageId>
    <Version>0.1.0-alpha.7</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.FSM_COS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.FSM_COS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Compute Operating System for composing MicroBundle-based computation: resolves and validates requested capabilities and dependencies, loads in dependency order, arbitrates to convergence, and returns a RuntimeAssembly to the host.</Description>
    <PackageTags>FSM;compute-operating-system;runtime-composition;microbundle;experience</PackageTags>
    <PackageReadmeFile>NuGet.README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1707 is intentionally suppressed because the published FSM_COS assembly and namespace names are compatibility contracts. -->
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <DefineConstants>$(DefineConstants);WORKSHOP_USE_REPOSITORY_SOURCES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheSingularityWorkshop.FSM_API" Version="1.0.13" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.FSM_UserIO" Version="0.1.0-alpha.1" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <ProjectReference Include="..\..\..\FSM_API\FSM_API\FSM_API.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\..\FSM_UserIO\TheSingularityWorkshop.FSM_UserIO.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\..\TheSingularityWorkshop.MicroBundleDomain\TheSingularityWorkshop.MicroBundleDomain.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
  </ItemGroup>

  <Target Name="ValidateWorkshopRepositorySources" BeforeTargets="PrepareForBuild" Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <Error Condition="!Exists('..\..\..\FSM_API\FSM_API\FSM_API.csproj')" Text="Workshop source mode requires sibling repository FSM_API on development." />
    <Error Condition="!Exists('..\..\..\FSM_UserIO\TheSingularityWorkshop.FSM_UserIO.csproj')" Text="Workshop source mode requires sibling repository FSM_UserIO on development." />
    <Error Condition="!Exists('..\..\..\TheSingularityWorkshop.MicroBundleDomain\TheSingularityWorkshop.MicroBundleDomain.csproj')" Text="Workshop source mode requires sibling repository TheSingularityWorkshop.MicroBundleDomain on development." />
  </Target>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../NuGet.README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="../../SECURITY.md" Pack="true" PackagePath="" />
    <None Include="../../DOCUMENTATION_INDEX.md" Pack="true" PackagePath="" />
    <None Include="../../docs/LEARNING_GUIDE.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/UML_VISUAL_STYLE.md" Pack="true" PackagePath="docs/" />
    <!-- Ship task-oriented consumer documentation only. Internal roadmaps, ancestry,
         integration planning, release gates, and documentation-process notes stay in source. -->
    <None Include="../../docs/WHAT_IS_FSM_COS.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/THEORY.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/MANIFEST_THEORY.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/ARCHITECTURE.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/CONSUMING_MICROBUNDLES.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/DOMAIN.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/ARBITRATION.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/RUNTIME_ASSEMBLY.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/RUNTIME_BOUNDARY.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/RUNTIME_MANIFEST.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/STAGED_MANIFEST_LOADING.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/COMPOSITION_FAILURES.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/WEBPAGE_INTEGRATION.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/GALLERY.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/WORKSHOP_REPOSITORIES.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/releases/0.1.0-alpha.7.md" Pack="true" PackagePath="docs/releases/" />
    <None Include="../../docs/assets/**/*" Pack="true" PackagePath="docs/assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
