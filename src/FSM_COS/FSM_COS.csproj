<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.FSM_COS</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Runtime composition substrate for assembling Experiences from FSM infrastructure and MicroBundles.</Description>
    <PackageTags>FSM;runtime;composition;microbundle;experience</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TheSingularityWorkshop.FSM_API" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/*.md" Link="Documentation/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
